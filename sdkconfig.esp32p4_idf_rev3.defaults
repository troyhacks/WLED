# The ESP32-P4 rev 3 - Espressif's own settings for this chip.
#
# This is Espressif's rev-3 P4 config, layered the way their build layers
# it (esp32-arduino-lib-builder, configs/):
#
#   defconfig.common + defconfig.esp32p4 + defconfig.qio_ram
#   + defconfig.esp_sr + defconfig.qio + defconfig.80m_200m
#
# ("defconfig.esp32p4" is the one *without* the "_es" suffix - that one is
# the older "ES pre rev.300" chip.)
#
# The P4 changed its SRAM map in rev 3, and ESP-IDF's support for the two is
# mutually exclusive: the shared sdkconfig.defaults selects the older layout,
# and this file selects the newer one.  The IDF's minimum revision for the
# newer layout is 3.1; the chip is a 3.2.
#
# This file is picked up by pio-scripts/env_sdkconfig.py, which puts it after
# the shared defaults, so that what is here wins.

# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
# CONFIG_ESP32P4_REV_MIN_1 is not set
CONFIG_ESP32P4_REV_MIN_301=y

# The 200 MHz PSRAM (the display's framebuffers live there) and the USB
# host's enumeration filter are behind this.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# The PSRAM is not initialised at boot: the ROM's own boot path does it,
# and doing it again in the bootloader leaves it in a state the
# application cannot use.
# CONFIG_SPIRAM_BOOT_HW_INIT is not set
# CONFIG_SPIRAM_BOOT_INIT is not set

# The hosted coprocessor
CONFIG_ESP_HOSTED_USE_MEMPOOL=n

# lwIP: the buffers the WLED-MM build uses
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

# The USB host
CONFIG_USB_HOST_ENABLE_ENUM_FILTER_CALLBACK=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=3000

# The display and the audio: the ISRs stay safe while the flash writes
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y
CONFIG_ANA_CMPR_ISR_HANDLER_IN_IRAM=y
CONFIG_ANA_CMPR_OBJ_CACHE_SAFE=y
CONFIG_I2S_ISR_IRAM_SAFE=y

# The filesystem: long file names, and the partition's label
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_USE_LABEL=y
CONFIG_FATFS_CODEPAGE_850=y

# The SDMMC driver says what went wrong at DEBUG level, and that is the only
# place the status register with the error bits in it is printed.  The strings
# have to be in the binary for that, so the maximum level is DEBUG and the
# tags that matter are turned up where the card is mounted.
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# A crash leaves a core in the flash, which is the only way to see where a
# boot died on a board whose console says nothing.
CONFIG_ESP_COREDUMP_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=64
CONFIG_ESP_COREDUMP_STACK_SIZE=0

# The stacks and the timeouts the WLED-MM build uses
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_ESP_IPC_TASK_STACK_SIZE=2048
CONFIG_ESP_TIMER_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=1024
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=2048
CONFIG_SPI_FLASH_WRITE_CHUNK_SIZE=4096
CONFIG_SPI_FLASH_ERASE_YIELD_DURATION_MS=10
CONFIG_SPI_FLASH_ERASE_YIELD_TICKS=2

# The WiFi driver (the C6 coprocessor carries it)
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=10
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_RX_BA_WIN=16
