# WLED-MM-P4 - ESP-IDF configuration for the pure IDF build.
#
# These values were taken from the Arduino core's own P4 sdkconfig
# (framework-arduinoespressif32-libs/esp32p4/sdkconfig) so the pure IDF build
# lands on the same silicon settings the Arduino build uses today, plus the
# overrides that WLED's platformio.ini passes as -D CONFIG_* build flags.
#
# Arduino-only options (CONFIG_ARDUINO_RUNNING_CORE, CONFIG_ARDUINO_EVENT_*,
# CONFIG_OTA_VERSION_FORCE_SLAVEFW) are gone: there is no Arduino core any more.

CONFIG_IDF_TARGET="esp32p4"

# --- flash -----------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_BEFORE_RESET=y
CONFIG_ESPTOOLPY_AFTER_RESET="hard_reset"

# --- partitions ------------------------------------------------------------
# Byte-identical to tools/WLED_ESP32_8MB_1500KB_FS.csv so the Arduino build and
# the IDF build can share a device.  The filesystem partition keeps the label
# "spiffs" on purpose: the label is what LittleFS mounts by, and changing it
# would orphan the data on every deployed board.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="tools/WLED_ESP32_8MB_1500KB_FS.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

# --- the watchdog -----------------------------------------------------------
# The task watchdog's idle check on the second core is off, the way the
# Arduino build has it.  WLED's enableWatchdog() reconfigures the watchdog to
# watch both cores, and the AudioReactive's analysis task lives on the second
# core - so with the check on, the board resets itself.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_TASK_WDT_TIMEOUT_S=5

# --- the bootloader ---------------------------------------------------------
# The bootloader is compiled for size, and it logs at error level only, and it
# does not validate the image in deep sleep.  These are the settings the
# Arduino build uses, and they matter: the bootloader has to fit between the
# offset it is flashed at (0x2000) and the partition table (0x8000), and a
# bootloader built any other way does not fit there.
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_LOG_BOOTLOADER_LEVEL_ERROR=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
# --- the P4's memory layout ------------------------------------------------
# The P4 changed its SRAM map in rev 3.  The board is an "ES pre rev.300"
# part, and the Arduino build runs on ESP-IDF 5.3, which only had the older
# layout - so the pure IDF build has to use the same one, or the linker is
# given a memory map that does not match the sections script.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# --- PSRAM -----------------------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=0
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# --- CPU / task model ------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_FREERTOS_HZ=1000
# The Arduino build ran the WLED main loop on a 12000 byte task pinned to core 0
# (see wled00/wled00.ino, "Core 0 Migrator").  The IDF build does the same with
# its own task; this only sizes the IDF main task.
#
# It is 12288 and not 4096 because the main task is the one that serves the
# web interface, and the HID control surface's /json/ar builds the DWC2
# register dump on it - with the USB stack in its error path, that overflowed
# a 4096 byte stack and the board panicked with "Stack protection fault".
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
# The Arduino build forced the TCP/IP task onto core 1 (platformio.ini:
# -D CONFIG_LWIP_TCPIP_TASK_AFFINITY=1 / ..._CPU1=1).
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=n
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY=0x1

# --- Ethernet (the P4 has no Wi-Fi radio; the C6 coprocessor is esp-hosted) --
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_USE_SPI_ETHERNET=y

# --- The hosted coprocessor ----------------------------------------------
#
# ESP-IDF 6.0 moved the Wi-Fi "remote" (slave) support into the IDF's own
# esp_wifi component, and esp_hosted 3.x is the backend behind it.  The C6
# is reached over SDIO - slot 1, 4 bits, 40 MHz, which are esp_hosted's
# defaults for the P4.
#
# The 3.x host is back-compatible with the 2.x coprocessor firmware, so the
# C6 does not have to be reflashed.
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=40000
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
#
# The coprocessor is not reset by the host - and that is not something
# this file can say.  esp_hosted 3.x resets the C6 every time the host
# boots (it drives the EN line: parked high, pulsed low), and the C6
# does not come back from that pulse: the SDIO card init times out on
# the OCR and the link never comes up.  esp_hosted 2.x did not reset it
# - the C6 boots with the P4 and keeps running, and the host just talks
# to it.
#
# The option that would say it is CONFIG_ESP_HOSTED_HOST_RESET_GPIO=-1
# ("no in-band reset"), but the value is checked against a range that
# comes from CONFIG_ESP_HOSTED_SDIO_RESET_SLAVE_GPIO_MIN/MAX, and
# those are invisible Kconfig symbols - a defaults file cannot set
# them.  So it needs a patch of the component.
#
# The Wi-Fi is not compiled in this firmware anyway
# (WLED_USE_ETHERNET_ONLY), so the link is not wanted here; what the
# transport does cost is the SDMMC slot: it takes the one the SD card
# wants, and the card falls back to 20 MHz.

# --- filesystem ------------------------------------------------------------
# The Arduino core's LittleFS library is guarded by CONFIG_LITTLEFS_PAGE_SIZE,
# so the page size has to be there for the class to exist at all.  These are
# the values the Arduino build uses.
CONFIG_LITTLEFS_PAGE_SIZE=256
CONFIG_LITTLEFS_MAX_PARTITIONS=3
CONFIG_LITTLEFS_READ_SIZE=128
CONFIG_LITTLEFS_WRITE_SIZE=128
CONFIG_LITTLEFS_LOOKAHEAD_SIZE=128
CONFIG_LITTLEFS_CACHE_SIZE=512
CONFIG_LITTLEFS_BLOCK_CYCLES=512
CONFIG_LITTLEFS_USE_MTIME=y

# --- FreeRTOS --------------------------------------------------------------
# WLED's task list prints each task's core, and that field only exists when
# FreeRTOS is built with the core id in its statistics.
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# --- compiler --------------------------------------------------------------
# The Arduino build used -Ofast -fno-exceptions -fno-rtti -DNDEBUG.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
; ESP-IDF 6.0 replaced the old CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS with a
; level: DISABLE (0), SILENT (1) or ENABLE (2, the default).  The Arduino
; build had the assertions off, so DISABLE is what keeps the two builds the
; same.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
; CONFIG_COMPILER_WARN_UNINITIALIZED_AUTOS is gone in ESP-IDF 6.0 - the
; warning it turned on does not exist any more.
# ESP-IDF's own code - and the bootloader with it - is built for size.  The
# bootloader has to fit between the offset it is flashed at (0x2000) and the
# partition table (0x8000), and WLED's own code asks for speed, so it sets
# its own flags (see wled00/CMakeLists.txt).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
CONFIG_COMPILER_DISABLE_GCC12_WARNINGS=y

# --- logging / watchdog ----------------------------------------------------
# CORE_DEBUG_LEVEL=0 in the Arduino build; IDF level 1 is ERROR.
CONFIG_LOG_DEFAULT_LEVEL=1
CONFIG_LOG_MAXIMUM_LEVEL=3
# Frame pointers, so the panic handler can print a backtrace.  Without
# them it says so and prints nothing:
#   "Please enable CONFIG_ESP_SYSTEM_USE_FRAME_POINTER option to have a
#    full backtrace."
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# --- USB and the console ---------------------------------------------------
# The console writes to USB-Serial-JTAG *and* to UART0: WLED's own console
# takes the USB peripheral over, and ESP_LOG goes to UART0, which is what the
# Arduino build does too.
#
# The ESP-IDF console is on UART0 rather than on USB-Serial-JTAG, because the
# USB console code makes the second stage bootloader bigger than the space
# between the bootloader and the partition table.
CONFIG_ESP_CONSOLE_UART=y
CONFIG_ESP_CONSOLE_UART_NUM=0

# --- the USB host ----------------------------------------------------------
# The Arduino build has these, the IDF build did not: the external hub
# support was off, so anything behind a hub was invisible to the host - the
# F1 was plugged in and simply never appeared ("External Hubs support
# disabled, Hub device was not initialized").
#
# The FIFO bias stays as the IDF has it ("Balanced") - WLED's own USB host
# code requires it, and says so (wled.cpp).
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y
