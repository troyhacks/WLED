# sdkconfig.p4.defaults — ESP-IDF component config for WLED pure IDF build on ESP32-P4.
# Used by [env:esp32p4_8MB_idf] via board_build.cmake_extra_args.

# ─── Target ───────────────────────────────────────────────────────────────────
CONFIG_IDF_TARGET="esp32p4"

# ─── Experimental features (needed for SPIRAM_SPEED_200M) ─────────────────────
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ─── Task / stack sizes ───────────────────────────────────────────────────────
CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y

# ─── PSRAM ────────────────────────────────────────────────────────────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_FORCE_DISABLE=n

# ─── Flash / partitions ───────────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ─── LittleFS ─────────────────────────────────────────────────────────────────
CONFIG_LITTLEFS_FOR_IDF_5_0=y

# ─── NVS ──────────────────────────────────────────────────────────────────────
CONFIG_NVS_ENCRYPTION=n

# ─── HTTP server ──────────────────────────────────────────────────────────────
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_SOCKETS=12

# ─── ETH ──────────────────────────────────────────────────────────────────────
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_OPENETH=n

# ─── mDNS ─────────────────────────────────────────────────────────────────────
CONFIG_MDNS_MAX_SERVICES=8

# ─── I2C ──────────────────────────────────────────────────────────────────────
CONFIG_I2C_ENABLE_DEBUG_LOG=n

# ─── I2S ──────────────────────────────────────────────────────────────────────
CONFIG_SOC_I2S_SUPPORTED=y

# ─── LCD / MIPI DSI / PPA (P4-specific) ───────────────────────────────────────
CONFIG_LCD_ENABLE_DEBUG_LOG=n
CONFIG_SOC_MIPI_DSI_SUPPORTED=y
CONFIG_SOC_PPA_SUPPORTED=y

# ─── Watchdog ─────────────────────────────────────────────────────────────────
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# ─── Logging ──────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# ─── Compiler ─────────────────────────────────────────────────────────────────
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=n
